  "devDependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/testing": "^11.1.29",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
